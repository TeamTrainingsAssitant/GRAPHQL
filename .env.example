# Kopieren nach .env und anpassen

# Port des Gateways (Heroku setzt PORT automatisch)
PORT=4000

# Basis-URL des Spring-Backends (REST)
BACKEND_BASE_URL=http://localhost:8080/api/v1

# Erlaubte Frontend-Origins, kommagetrennt
CORS_ORIGINS=http://localhost:4200,http://localhost:5500,http://localhost:8000

# Lebensdauer des Gateway-Caches in Sekunden
CACHE_TTL_SECONDS=300
